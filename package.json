{
  "name": "elogbook",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "22.x",
    "pnpm": ">=9.0.0 <10"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "tar": "7.5.19",
      "@sentry/nextjs": "10.75.2",
      "dompurify": "3.4.17",
      "next": "16.4.1",
      "vite": "8.3.5",
      "zod@>=4.0.0 <5": "4.6.6",
      "sharp": "0.35.5",
      "js-yaml": "4.3.2",
      "source-map-js": "1.2.2",
      "compression": "1.8.2",
      "shell-quote": "1.12.0",
      "brace-expansion@>=4.0.0 <5.0.11": "5.0.12",
      "fast-uri": "3.1.9",
      "undici@>=7.0.0 <8": "7.30.1",
      "undici@>=6.0.0 <7": "6.29.1",
      "@xmldom/xmldom@>=0.9.0 <0.10": "0.9.12",
      "@xmldom/xmldom@>=0.8.0 <0.9": "0.8.15"
    }
  },
  "dependencies": {
    "@next/bundle-analyzer": "^16.2.9",
    "framer-motion": "^12.40.0",
    "next": "^16.2.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "scripts": {
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm lint:all",
    "lint:all": "pnpm --filter @elogbook/web lint && pnpm --filter @elogbook/mobile lint",
    "test": "pnpm test:unit",
    "test:unit": "pnpm --filter @elogbook/shared test && pnpm --filter @elogbook/ops test && pnpm --filter @elogbook/web test && pnpm --filter @elogbook/mobile test",
    "test:db": "supabase db test",
    "test:watch": "pnpm --filter @elogbook/web test:watch",
    "test:coverage": "pnpm --filter @elogbook/web test:coverage",
    "test:e2e": "pnpm --filter @elogbook/web test:e2e",
    "dev:web": "pnpm --filter @elogbook/web dev",
    "dev:mobile": "pnpm --filter @elogbook/mobile start",
    "build:web": "pnpm --filter @elogbook/web build",
    "build:mobile:validate": "pnpm --filter @elogbook/mobile expo prebuild --clean",
    "analyze": "ANALYZE=true pnpm build:web",
    "db:migrate": "supabase db push",
    "functions:deploy": "supabase functions deploy generate-pdf && supabase functions deploy ai-insights && supabase functions deploy payment-webhook && supabase functions deploy create-checkout",
    "security:scan": "pnpm audit --prod --audit-level=high && trivy image --severity CRITICAL --exit-code 1 --ignore-unfixed elogbook-web:scan",
    "release:verify": "pnpm check && pnpm build:web && pnpm security:scan",
    "audit:wcag": "tsx scripts/wcag-audit.mts"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@vitest/coverage-v8": "^4.1.9",
    "babel-preset-expo": "^56.0.14",
    "eslint-plugin-react": "^7.37.5",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^6.0.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.9"
  }
}
