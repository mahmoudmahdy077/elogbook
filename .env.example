# E-Logbook local web development
#
# Copy this file to .env.local and replace only the blank values with the
# credentials reported by `supabase status -o env` for your local project.
# Never commit .env.local or any real secret.

# Required by the web app (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required only by server-side web routes. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Deployment contract — REQUIRED in production. In dev/test defaults to single-instance.
# distributed: horizontally scaled, requires UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN.
# single-instance: single-process self-hosted (Compose installer), local Map only (reduced-security, credential keys capped at 5).
RATE_LIMIT_MODE=single-instance
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Trusted proxy hops — REQUIRED in production. 0 = trust nothing (use X-Real-IP/socket), 1 = single Caddy hop (pilot default).
TRUSTED_PROXY_HOPS=1
SETUP_MODE=false
SETUP_PHASE=
SETUP_BIND_ADDRESS=127.0.0.1
SETUP_REMOTE_TLS_REQUIRED=true
SETUP_BOOTSTRAP_TOKEN=
SETUP_STATE_DIR=/app/data

# Optional Sentry configuration. Leave blank for local development.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENV=development
SENTRY_DSN=
SENTRY_ENV=development
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_SILENT=true
SENTRY_TRACES_SAMPLE_RATE=0.0
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.0
NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.0

# Optional consent-gated web analytics. Do not enable for clinical views until
# the privacy review in ENTERPRISE_TRANSFORMATION_PLAN.md is complete.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Build flags
# Set to "true" to skip MFA enforcement in local development
DISABLE_MFA=true

NODE_ENV=development
ANALYZE=false

# Enterprise email (Resend primary + SMTP fallback)
EMAIL_ENABLED=true
EMAIL_PROVIDER=resend+smtp
EMAIL_FROM_ADDRESS=noreply@example.com
EMAIL_FROM_NAME=E-Logbook
EMAIL_REPLY_TO=
EMAIL_DATA_ENCRYPTION_KEYS=
EMAIL_DATA_ACTIVE_KEY_VERSION=1
EMAIL_LOOKUP_HMAC_KEY=
EMAIL_TOKEN_SIGNING_SECRET=
EMAIL_CRON_SECRET=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_ALERT_TO=
EMAIL_RATE_PER_MIN=60
EMAIL_FROM=

